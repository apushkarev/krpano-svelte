<krpano
	debugjsactions="true"
>
	
	<action name="startup0" init_run_before_start="false">
	
		if (device.desktop,
			invoke('setKRPanoConsole');
		);

		invoke('readURL');

		delayedcall (0.5,
			callwith(layer[menu_button_background], show);
		);

		menu.create_items();

		load_scene(get(settings.start_scene));
		
	</action>
	
</krpano>
